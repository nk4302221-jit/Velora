# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL / Relational SQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_ecommerce_app_2026_xyz

# OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect callback used by the server-side Google OAuth redirect flow.
# MUST match the Authorized redirect URI in the Google Cloud Console exactly.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Stripe Sandbox Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay Payment Gateway
# TEST MODE recommended. Replace placeholders with real test keys to switch from
# the built-in sandbox simulation to the real Razorpay checkout UI.
# RAZORPAY_ENV=test   |   RAZORPAY_ENV=live (only for production, never commit live keys)
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=rzp_test_example123456
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# Public key id only. The backend returns the keyId to the checkout at run time;
# this VITE var is only needed if you load the Razorpay script/key outside the
# backend-provided flow. NEVER put RAZORPAY_KEY_SECRET in a VITE_ variable.
VITE_RAZORPAY_KEY_ID=rzp_test_example123456

# Google Maps API
# FRONTEND key consumed by the GoogleMapsPicker. Vite exposes only VITE_* vars
# to the browser, so this variant is the one that matters. Paste your real key.
VITE_GOOGLE_MAPS_API_KEY=
# Google Map ID - required when using google.maps.marker.AdvancedMarkerElement.
# Create it in Google Cloud Console > Map Management, then paste it here.
VITE_GOOGLE_MAP_ID=
# Backwards-compatible alias for the Map ID (older configs used this name).
VITE_GOOGLE_MAPS_MAP_ID=

# Storj Cloud Storage
STORJ_ACCESS_KEY=
STORJ_SECRET_KEY=
STORJ_BUCKET=

# =====================================================
# Email (SMTP) - REQUIRED for email verification
# =====================================================
# Registration and "Resend Code" email a 6-digit verification code through this
# transport. SMTP_HOST / SMTP_USER / SMTP_PASSWORD and SMTP_FROM must ALL be set
# for real delivery; a partial set is treated as unconfigured and reported as
# emailSent:false with errorCode SMTP_NOT_CONFIGURED plus the list of missing
# variable names, rather than silently redirecting mail to a sandbox.
#
#   Gmail / Google Workspace  smtp.gmail.com              587  (App Password)
#   Brevo / SendGrid          smtp-relay.brevo.com        587
#   Resend                    smtp.resend.com             465
#   Mailtrap                  smtp.mailtrap.io           2525
#   Amazon SES                email-smtp.<region>.amazonaws.com 587
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Required. Must be a sender on the authenticated account - a placeholder here
# is rejected by real providers as an unrelated "sender not verified" error.
SMTP_FROM="Velora" <your-address@example.com>
# Optional: force TLS/SSL instead of deriving it from the port (465 = SSL).
# SMTP_SECURE=false
# Optional: give up on an unresponsive SMTP server after N ms (default 15000).
# SMTP_TIMEOUT_MS=15000
# Backwards-compatible aliases (used when the vars above are empty):
# SMTP_PASS=
# EMAIL_FROM=
#
# MAIL_MODE values:
#   smtp      Real delivery. The only mode allowed when NODE_ENV=production.
#   console   Sends nothing and is reported to the API as a FAILURE, so a
#             verification code is never claimed as delivered. Password-reset
#             links are printed to the backend console; the 6-digit verification
#             code is never printed. Offline testing only.
#   ethereal  Delivers to a throwaway @ethereal.email sandbox, not a real inbox.
#   disabled  No usable config; every send fails loudly with SMTP_NOT_CONFIGURED.
# MAIL_MODE=console

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# =====================================================
# SMS - REQUIRED ONLY FOR "LOGIN WITH MOBILE NUMBER + OTP"
# =====================================================
# Velora does not ship an SMS provider. There is no SMS SDK in package.json and
# no SMS transport implemented, so until the four variables below are set AND a
# transport is written in backend/services/smsService.js, mobile OTP sign-in is
# unavailable.
#
# While SMS is unconfigured the API answers 503 SMS_NOT_CONFIGURED with the list
# of missing variables, and the sign-in page says so up front. It never reports
# a code as "sent" when nothing left the process. Email OTP sign-in, password
# sign-in and Google sign-in are completely unaffected.
#
#   SMS_PROVIDER     provider name, e.g. twilio, msg91, textlocal
#   SMS_ACCOUNT_SID  provider account/space identifier
#   SMS_AUTH_TOKEN   provider API key / auth token
#   SMS_FROM         sender id or sender number registered with the provider
# SMS_PROVIDER=
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM=

